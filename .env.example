# Postgres connection string (Vercel Postgres / Neon / Supabase ...)
DATABASE_URL=

# OpenAI API key used by the agent
OPENAI_API_KEY=

# The single password for logging in to the app
APP_PASSWORD=

# Optional: override the model id (default: gpt-6-luna). A leading "openai/" is ignored.
# OPENAI_MODEL=gpt-6-luna

# Optional: secret used to sign the session cookie (defaults to APP_PASSWORD)
# AUTH_SECRET=

# Web Push (reminders). Generate a VAPID key pair once, e.g. with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Usually "mailto:you@example.com" — identifies you to push services.
VAPID_SUBJECT=

# Shared secret for the reminders cron route (/api/cron/reminders). Call it every minute from
# an external scheduler such as cron-job.org with header: Authorization: Bearer <this value>.
# Vercel's own Cron Jobs (used for the optional /api/cron/morning) send this header
# automatically once this variable is set, so one secret covers both routes.
CRON_SECRET=
